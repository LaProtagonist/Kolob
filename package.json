    "financial:core:sync": "node docs-platform/app/node_modules/tsx/dist/cli.mjs scripts/generate-financial-core-projection.ts",
    "financial:core:check": "node docs-platform/app/node_modules/tsx/dist/cli.mjs scripts/generate-financial-core-projection.ts --check",
    "investor:economics:sync": "node docs-platform/app/node_modules/tsx/dist/cli.mjs scripts/generate-investor-economics-projection.ts",
