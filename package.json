{
  "name": "kolobochnaya-investor-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "npm --prefix docs-platform/app ci --ignore-scripts && node scripts/install-playwright-browser.cjs",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:spa && npm run prerender",
    "build:spa": "npm run investor:start:validate && npm run capex:web:check && npm run revenue:model:validate && npm run revenue:web:check && tsc -b && vite build",
    "prerender": "node scripts/prerender-dist.cjs",
    "serve:dist": "node scripts/serve-dist.cjs",
    "preview": "node scripts/serve-dist.cjs",
    "prepare:media": "node scripts/prepare-media.mjs",
    "audit:content": "node scripts/audit-content.mjs",
    "audit:links": "node scripts/audit-links.mjs",
    "audit:seo": "node scripts/audit-seo.mjs",
    "audit:assets": "node scripts/audit-assets.mjs",
    "audit:routes": "node scripts/audit-route-html.mjs",
    "test": "npm run investor:start:validate && npm run capex:web:check && npm run revenue:model:validate && npm run revenue:web:check && node scripts/test-site.cjs && npm --prefix docs-platform/app test",
    "capex:web:sync": "npm --prefix docs-platform/app run capex:web:sync",
    "capex:web:check": "npm --prefix docs-platform/app run capex:web:check",
    "capex:governance:sync": "npm --prefix docs-platform/app run capex:governance:sync",
    "investor:start:validate": "npm --prefix docs-platform/app run investor:start:validate",
    "revenue:model:validate": "npm --prefix docs-platform/app run revenue:model:validate",
    "revenue:web:sync": "npm --prefix docs-platform/app run revenue:web:sync",
    "revenue:web:check": "npm --prefix docs-platform/app run revenue:web:check",
    "registry:validate": "npm --prefix docs-platform/app run registry:validate",
    "timeline:validate": "npm --prefix docs-platform/app run timeline:validate",
    "context:build": "npm --prefix docs-platform/app run context:build",
    "context:validate": "npm --prefix docs-platform/app run context:validate",
    "project:onboard": "npm --prefix docs-platform/app run project:onboard",
    "iteration:commit": "npm --prefix docs-platform/app run iteration:commit --",
    "iteration:seal": "npm --prefix docs-platform/app run iteration:seal --",
    "iteration:finalize": "npm --prefix docs-platform/app run iteration:finalize --",
    "iteration:rollback:preview": "npm --prefix docs-platform/app run iteration:rollback:preview --",
    "iteration:rollback:prepare": "npm --prefix docs-platform/app run iteration:rollback:prepare --",
    "iteration:compensate:preview": "npm --prefix docs-platform/app run iteration:compensate:preview --",
    "google:drift:check": "npm --prefix docs-platform/app run google:drift:check",
    "deployment:drift:check": "npm --prefix docs-platform/app run deployment:drift:check",
    "deployment:manifest:write": "npm --prefix docs-platform/app run deployment:manifest:write --",
    "deployment:receipt:record": "npm --prefix docs-platform/app run deployment:receipt:record --",
    "build:reproduce:sealed": "node scripts/check-sealed-build.mjs",
    "artifact:validate": "npm --prefix docs-platform/app run artifact:validate",
    "governance:validate": "npm --prefix docs-platform/app run governance:validate",
    "contact:server": "node server/contact-server.mjs"
  },
  "dependencies": {
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "playwright": "^1.61.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
