    "investor:summary:validate": "npm --prefix docs-platform/app run investor:summary:validate",
    "investor:summary:sync": "npm --prefix docs-platform/app run investor:summary:sync",
    "investor:summary:check": "npm --prefix docs-platform/app run investor:summary:check",
    "investor:summary:sheet:payload": "npm --prefix docs-platform/app run investor:summary:sheet:payload",
    "investor:summary:sheet:check": "npm --prefix docs-platform/app run investor:summary:sheet:check",
