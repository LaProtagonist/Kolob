{
  "name": "kolobochnaya-investor-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "npm --prefix docs-platform/app ci --ignore-scripts && node scripts/install-playwright-browser.cjs",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:spa && npm run prerender",
    "build:spa": "npm run investor:start:validate && npm run capex:web:check && npm run revenue:model:validate && npm run revenue:web:check && npm run network:planning:check && tsc -b && vite build",
