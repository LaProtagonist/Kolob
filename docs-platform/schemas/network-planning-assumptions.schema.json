{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["document", "references", "base_object", "temporal", "point_schedule", "staffing", "locations", "rental_presets", "network_rollout", "preparation", "traffic_presets", "opex", "launch", "logistics", "equipment"],
  "properties": {
    "document": { "type": "object", "required": ["id", "version", "status", "provenance", "boundary"], "properties": { "id": {"const": "DOC-NETWORK-PLANNING-ASSUMPTIONS"}, "version": {"const": "1.8"}, "status": {"const": "owner_approved_planning"}, "provenance": {"type": "string"}, "boundary": {"type": "string"} }, "additionalProperties": true },
    "references": { "type": "object", "required": ["financial_model", "revenue_model", "physical_allocation"], "properties": { "financial_model": {"type": "string"}, "revenue_model": {"type": "string"}, "physical_allocation": {"type": "string"} }, "additionalProperties": false },
    "base_object": { "type": "object", "required": ["flagship_reference"], "additionalProperties": true },
    "temporal": { "type": "object", "required": ["financial_model_source", "calendar_start_month_source", "horizon_months_source", "ramp_up_profile_source", "seasonality_profile_source", "development_lead_months", "rent_free_defaults", "provenance"], "additionalProperties": true },
    "point_schedule": { "type": "object", "required": ["core", "peak"], "additionalProperties": true },
    "staffing": { "type": "object", "required": ["payroll_contribution_scenario", "takeaway", "seating", "production", "shared_manager"], "additionalProperties": true },
    "locations": { "type": "object", "required": ["types"], "additionalProperties": true },
    "rental_presets": { "type": "object", "required": ["default_id", "standard_network_point", "presets"], "additionalProperties": true },
    "network_rollout": { "type": "object", "required": ["default_additional_point_count", "district_preset_ids", "default_point", "groups", "size_presets"], "additionalProperties": true },
    "preparation": { "type": "object", "required": ["point_area_proxy"], "additionalProperties": true },
    "traffic_presets": { "type": "object", "required": ["street_takeaway", "creative_cluster", "foodhall"], "additionalProperties": true },
    "opex": { "type": "object", "required": ["marketing", "network_completion"], "additionalProperties": true },
    "launch": { "type": "object", "required": ["uniform_per_roster_employee_rub", "initial_inventory_operating_days"], "additionalProperties": true },
    "logistics": { "type": "object", "required": ["own_vehicle_suggested_from_point_count", "own_vehicle_point_count_scope", "own_vehicle_capex_rub", "own_vehicle_monthly_total_rub", "driver_salary_rub", "vehicle_financial_treatment", "external_logistics_coverage"], "additionalProperties": true },
    "equipment": { "type": "object", "required": ["bar_enabled_point_items", "point_wash_packages"], "additionalProperties": true }
  },
  "additionalProperties": false
}
