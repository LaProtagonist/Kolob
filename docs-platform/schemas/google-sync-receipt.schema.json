{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["receipt_version", "iteration_id", "content_commit_hash", "local_source_sha256", "google_file_id", "google_mime_type", "remote_readback_sha256", "synced_at", "result"],
  "properties": {
    "receipt_version": { "const": 2 },
    "iteration_id": { "type": "string", "minLength": 1 },
    "content_commit_hash": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "local_source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "google_file_id": { "type": "string", "minLength": 1 },
    "google_mime_type": { "type": "string", "minLength": 1 },
    "remote_readback_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "synced_at": { "type": "string", "minLength": 1 },
    "result": { "enum": ["passed", "failed"] }
  }
}

