{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["meta", "scenarios", "modules", "formats", "moduleItems", "items", "investorStartModel"],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "schemaVersion",
        "contentState",
        "contentStateSha256",
        "sourceHashes",
        "sourceBundleSha256",
        "counts",
        "scenarioTotalsRub"
      ],
      "properties": {
        "schemaVersion": { "const": 2 },
        "contentState": {
          "type": "object",
          "required": ["schema_version", "snapshot_schema_version", "source_files", "content_state_sha256"],
          "properties": {
            "schema_version": { "const": 1 },
            "snapshot_schema_version": { "const": 2 },
            "source_files": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["path", "sha256", "normalization"],
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                  "normalization": { "enum": ["yaml_canonical_nfc", "json_canonical_nfc", "text_lf_nfc", "public_document_projection"] }
                },
                "additionalProperties": false
              }
            },
            "content_state_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          },
          "additionalProperties": false
        },
        "contentStateSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sourceBundleSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sourceHashes": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "gitBaselineCommit": { "const": "не зафиксирован" }
      },
      "additionalProperties": true
    },
    "scenarios": { "type": "array" },
    "modules": { "type": "array" },
    "formats": { "type": "array" },
    "moduleItems": { "type": "array" },
    "items": { "type": "array" },
    "investorStartModel": { "type": "object" }
  },
  "additionalProperties": true
}
