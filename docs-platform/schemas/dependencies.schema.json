{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "dependencies"],
  "properties": {
    "schema_version": { "const": 1 },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source_document_id", "priority", "status", "version", "target_documents", "updated_at"],
        "properties": {
          "id": { "type": "string" },
          "source_document_id": { "type": "string" },
          "priority": { "enum": ["governing_source"] },
          "status": { "enum": ["idea", "research", "proposed", "approved", "superseded", "rejected"] },
          "version": { "type": "string" },
          "target_documents": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["title", "document_id"],
              "properties": {
                "title": { "type": "string" },
                "document_id": { "type": ["string", "null"] }
              },
              "additionalProperties": false
            }
          },
          "updated_at": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
