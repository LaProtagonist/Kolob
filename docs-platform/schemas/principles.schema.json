{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "principles"],
  "properties": {
    "schema_version": { "const": 1 },
    "principles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "document", "status", "version", "canonical_text", "priority", "source_ids", "decision_id", "updated_at"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "document": { "type": "string" },
          "status": { "enum": ["idea", "research", "proposed", "approved", "superseded", "rejected"] },
          "version": { "type": "string" },
          "canonical_text": { "type": "string", "minLength": 1 },
          "priority": { "enum": ["governing"] },
          "source_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "decision_id": { "type": ["string", "null"] },
          "updated_at": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
