{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "document", "links"],
  "properties": {
    "schema_version": { "const": 1 },
    "document": { "type": "object" },
    "links": {
      "type": "array", "minItems": 160,
      "items": {
        "type": "object",
        "required": ["module_id", "item_id", "default_requirement", "quantity_rule_type", "quantity_rule_value", "minimum_quantity", "aggregation_rule", "condition", "notes"],
        "properties": {
          "module_id": { "type": "string", "pattern": "^MOD-[A-Z-]+$" },
          "item_id": { "type": "string", "pattern": "^CAPEX-[0-9]{2}-[0-9]{3}$" },
          "default_requirement": { "enum": ["required", "optional", "conditional", "tbd"] },
          "quantity_rule_type": { "enum": ["fixed", "per_seat", "per_guest_area_m2", "per_workstation", "per_cashier_post", "per_hot_kitchen_post", "per_filling", "per_station", "manual", "tbd"] },
          "quantity_rule_value": { "type": ["number", "null"] },
          "minimum_quantity": { "type": ["number", "null"] },
          "aggregation_rule": { "enum": ["once", "sum", "max", "manual"] },
          "condition": { "type": ["string", "null"] },
          "notes": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
