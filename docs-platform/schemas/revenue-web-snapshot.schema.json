{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["meta", "model"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["schemaVersion", "dataVersion", "contentStateSha256", "sourceFiles", "currency"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "dataVersion": { "const": "0.1" },
        "contentStateSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sourceFiles": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "required": ["path", "sha256", "normalization"],
            "properties": {
              "path": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "normalization": { "enum": ["yaml_canonical_nfc", "json_canonical_nfc", "text_lf_nfc"] }
            },
            "additionalProperties": false
          }
        },
        "currency": { "const": "RUB" }
      },
      "additionalProperties": false
    },
    "model": { "$ref": "revenue-model.schema.json" }
  },
  "additionalProperties": false
}
