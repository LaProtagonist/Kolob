{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "document", "overrides"],
  "properties": {
    "schema_version": { "const": 1 },
    "document": { "type": "object" },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["configuration_id", "item_id", "action", "quantity_override", "specification_override", "requirement_override", "reason", "lifecycle_status", "notes"],
        "properties": {
          "configuration_id": { "type": "string", "pattern": "^CFG-[A-Z0-9-]+$" },
          "item_id": { "type": "string", "pattern": "^CAPEX-0[1-5]-[0-9]{3}$" },
          "action": { "enum": ["include", "exclude", "replace", "change_quantity", "change_specification"] },
          "quantity_override": { "type": ["number", "null"], "minimum": 0 },
          "specification_override": { "type": ["string", "null"] },
          "requirement_override": { "enum": ["required", "optional", "conditional", "tbd", null] },
          "reason": { "type": "string", "minLength": 1 },
          "lifecycle_status": { "const": "research" },
          "notes": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
